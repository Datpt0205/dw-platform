{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "antd",
            "importNames": ["message", "notification"],
            "message": "The static API does not read the theme; use App.useApp()."
          }
        ],
        "patterns": [
          {
            "regex": "^(?!(?:antd|@ant-design/icons|@ant-design/nextjs-registry|dayjs|keycloak-js|next|react|react-dom)(?:/|$)|@dw/|node:|[.]|@/)",
            "message": "Not on the UI allowlist (ADR-0101 (Accepted) decision 4, CLAUDE.md Web UI): a library joins through its own Accepted ADR and an EXCEPTIONS entry in lib/__tests__/antd-only.test.ts."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "NewExpression[callee.object.name='Intl'][callee.property.name=/^(NumberFormat|DateTimeFormat)$/]",
        "message": "Numbers go through lib/money.ts, dates through lib/dates.ts."
      },
      {
        "selector": "CallExpression[callee.property.name=/^toLocale(Date|Time)?String$/]",
        "message": "Numbers go through lib/money.ts, dates through lib/dates.ts."
      },
      {
        "selector": "Property[key.name='currency'][value.value='VND']",
        "message": "Money goes through lib/money.ts (đ, never ₫)."
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/money.ts", "lib/dates.ts"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["app/studio/**/canvas/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "antd",
                "importNames": ["message", "notification"],
                "message": "The static API does not read the theme; use App.useApp()."
              }
            ],
            "patterns": [
              {
                "regex": "^(?!(?:antd|@ant-design/icons|@ant-design/nextjs-registry|dayjs|keycloak-js|next|react|react-dom|@xyflow/react)(?:/|$)|@dw/|node:|[.]|@/)",
                "message": "Not on the UI allowlist (ADR-0101 (Accepted) decision 4): under app/studio/**/canvas/** only the EXCEPTIONS entry for @xyflow/react (ADR-0101) is added to it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "e2e/**",
        "./vitest.config.mts",
        "./vitest.setup.ts",
        "./playwright.config.ts",
        "./postcss.config.mjs",
        "./next.config.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "antd",
                "importNames": ["message", "notification"],
                "message": "The static API does not read the theme; use App.useApp()."
              }
            ],
            "patterns": [
              {
                "regex": "^(?!(?:antd|@ant-design/icons|@ant-design/nextjs-registry|dayjs|keycloak-js|next|react|react-dom|vitest|@testing-library/react|@playwright/test|jsdom|@vitejs/plugin-react|tailwindcss|@tailwindcss/postcss|eslint|eslint-config-next|typescript)(?:/|$)|@types/|@dw/|node:|[.]|@/)",
                "message": "Not on the UI allowlist or DEV_ONLY (ADR-0101 (Accepted) decision 4): a test or config file may add only the dev tools lib/__tests__/antd-only.test.ts lists."
              }
            ]
          }
        ]
      }
    }
  ]
}
