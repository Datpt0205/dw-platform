{
  "schema": "dw.workflow/v1",
  "triggers": [
    {
      "id": "nhan_lead",
      "type": "trigger.datahub@1",
      "description": "Khi Nguồn dữ liệu Form website nhận một lead",
      "config": {
        "endpoint": "7d0c2f1e-5b4a-4c3d-9e8f-0a1b2c3d4e5f"
      }
    }
  ],
  "steps": [
    {
      "id": "cham_diem",
      "type": "ai.llm@2",
      "description": "Chấm điểm lead bằng AI",
      "config": {
        "instructions": "Chấm điểm lead theo tiêu chí của công ty.",
        "prompt": "Thông tin lead: {{ trigger.input }}",
        "output": "object",
        "output_schema": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer"
            },
            "tier": {
              "type": "string"
            }
          }
        }
      },
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential"
      },
      "timeout_s": 120,
      "on_error": "fail"
    },
    {
      "id": "phan_loai",
      "type": "logic.switch@1",
      "description": "Phân loại theo hạng",
      "config": {
        "on": "steps.cham_diem.response.tier",
        "cases": {
          "hot": [
            {
              "id": "lam_giau",
              "type": "logic.loop@1",
              "description": "Làm giàu dữ liệu tới khi đủ",
              "config": {
                "condition": "!steps.gop.response.complete",
                "max_iterations": 5,
                "body": [
                  {
                    "id": "tra_cuu",
                    "type": "logic.parallel@1",
                    "description": "Tra cứu song song",
                    "config": {
                      "branches": {
                        "cong_ty": [
                          {
                            "id": "tra_cong_ty",
                            "type": "tool.call@2",
                            "description": "Tra thông tin công ty",
                            "config": {
                              "tool": "company.lookup@1.0.0",
                              "arguments": {
                                "to": "{{ trigger.input.email }}"
                              }
                            },
                            "retry": {
                              "max_attempts": 3,
                              "backoff": "exponential"
                            },
                            "timeout_s": 30,
                            "on_error": "fail"
                          },
                          {
                            "id": "tom_cong_ty",
                            "type": "data.transform@1",
                            "description": "Tóm tắt công ty",
                            "config": {
                              "fields": {
                                "ket_qua": "trigger.input"
                              }
                            },
                            "retry": {
                              "max_attempts": 1,
                              "backoff": "fixed"
                            },
                            "timeout_s": 30,
                            "on_error": "fail"
                          }
                        ],
                        "mang_xa_hoi": [
                          {
                            "id": "tra_mxh",
                            "type": "tool.call@2",
                            "description": "Tra mạng xã hội",
                            "config": {
                              "tool": "social.lookup@1.0.0",
                              "arguments": {
                                "to": "{{ trigger.input.email }}"
                              }
                            },
                            "retry": {
                              "max_attempts": 3,
                              "backoff": "exponential"
                            },
                            "timeout_s": 30,
                            "on_error": "fail"
                          }
                        ],
                        "lich_su": [
                          {
                            "id": "tra_lich_su",
                            "type": "data.object.query@1",
                            "description": "Tìm các lần mua trước",
                            "config": {
                              "object": "lead",
                              "filter": {
                                "field": "status",
                                "op": "eq",
                                "value": "moi"
                              },
                              "limit": 50
                            },
                            "retry": {
                              "max_attempts": 1,
                              "backoff": "fixed"
                            },
                            "timeout_s": 30,
                            "on_error": "fail"
                          },
                          {
                            "id": "tom_lich_su",
                            "type": "data.transform@1",
                            "description": "Tóm tắt lịch sử mua",
                            "config": {
                              "fields": {
                                "ket_qua": "trigger.input"
                              }
                            },
                            "retry": {
                              "max_attempts": 1,
                              "backoff": "fixed"
                            },
                            "timeout_s": 30,
                            "on_error": "fail"
                          }
                        ]
                      },
                      "labels": {
                        "cong_ty": "Công ty",
                        "mang_xa_hoi": "Mạng xã hội",
                        "lich_su": "Lịch sử mua"
                      }
                    },
                    "retry": {
                      "max_attempts": 1,
                      "backoff": "fixed"
                    },
                    "timeout_s": 10,
                    "on_error": "fail"
                  },
                  {
                    "id": "gop",
                    "type": "ai.llm@2",
                    "description": "Gộp kết quả tra cứu",
                    "config": {
                      "instructions": "Chấm điểm lead theo tiêu chí của công ty.",
                      "prompt": "Thông tin lead: {{ trigger.input }}",
                      "output": "object",
                      "output_schema": {
                        "type": "object",
                        "properties": {
                          "score": {
                            "type": "integer"
                          },
                          "tier": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "retry": {
                      "max_attempts": 2,
                      "backoff": "exponential"
                    },
                    "timeout_s": 120,
                    "on_error": "fail"
                  }
                ],
                "max_reached": [
                  {
                    "id": "tao_viec_tay",
                    "type": "data.object.create@1",
                    "description": "Tạo việc bổ sung bằng tay",
                    "config": {
                      "object": "task",
                      "fields": {
                        "title": "{{ trigger.input.full_name }}"
                      }
                    },
                    "retry": {
                      "max_attempts": 1,
                      "backoff": "fixed"
                    },
                    "timeout_s": 30,
                    "on_error": "fail"
                  }
                ]
              },
              "retry": {
                "max_attempts": 1,
                "backoff": "fixed"
              },
              "timeout_s": 10,
              "on_error": "fail"
            }
          ]
        },
        "default": [
          {
            "id": "luu_tru",
            "type": "data.object.update@1",
            "description": "Đưa vào danh sách nuôi dưỡng",
            "config": {
              "object": "lead",
              "record_id": "{{ steps.luu_lead.record.id }}",
              "fields": {
                "status": "da_lien_he"
              }
            },
            "retry": {
              "max_attempts": 1,
              "backoff": "fixed"
            },
            "timeout_s": 30,
            "on_error": "fail"
          }
        ]
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 10,
      "on_error": "fail"
    },
    {
      "id": "bao_kenh",
      "type": "tool.call@2",
      "description": "Báo kênh bán hàng",
      "config": {
        "tool": "chat.post@1.0.0",
        "arguments": {
          "to": "{{ trigger.input.email }}"
        }
      },
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential"
      },
      "timeout_s": 30,
      "on_error": "fail"
    }
  ]
}
