          "type": "object",
          "properties": {
            "score": {
              "type": "integer"
            },
            "tier": {
              "type": "string"
            }
          }
        }
      },
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential"
      },
      "timeout_s": 120,
      "on_error": "fail"
