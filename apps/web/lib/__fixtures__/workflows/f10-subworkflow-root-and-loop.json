{
  "schema": "dw.workflow/v1",
  "triggers": [
    {
      "id": "nhan_lead",
      "type": "trigger.datahub@1",
      "description": "Khi Nguồn dữ liệu Form website nhận một lead",
      "config": {
        "endpoint": "7d0c2f1e-5b4a-4c3d-9e8f-0a1b2c3d4e5f"
      }
    }
  ],
  "steps": [
    {
      "id": "kiem_trung",
      "type": "flow.subworkflow@1",
      "description": "Kiểm lead trùng",
      "config": {
        "workflow": "kiem_lead_trung",
        "inputs": {
          "email": "trigger.input.email"
        }
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 300,
      "on_error": "fail"
    },
    {
      "id": "lam_giau",
      "type": "logic.loop@1",
      "description": "Làm giàu dữ liệu tới khi đủ",
      "config": {
        "condition": "!steps.lam_giau_mot_lan.outputs.complete",
        "max_iterations": 3,
        "body": [
          {
            "id": "lam_giau_mot_lan",
            "type": "flow.subworkflow@1",
            "description": "Làm giàu một lần",
            "config": {
              "workflow": "lam_giau_lead",
              "inputs": {
                "lead": "trigger.input"
              }
            },
            "retry": {
              "max_attempts": 1,
              "backoff": "fixed"
            },
            "timeout_s": 600,
            "on_error": "fail"
          }
        ]
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 10,
      "on_error": "fail"
    },
    {
      "id": "luu_lead",
      "type": "data.object.upsert@1",
      "description": "Lưu hoặc cập nhật Lead",
      "config": {
        "object": "lead",
        "fields": {
          "email": "trigger.input.email"
        }
      },
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential"
      },
      "timeout_s": 30,
      "on_error": "fail"
    }
  ]
}
