{
  "schema": "dw.workflow/v1",
  "triggers": [
    {
      "id": "nhan_lead",
      "type": "trigger.datahub@1",
      "description": "Khi Nguồn dữ liệu Form website nhận một lead",
      "config": {
        "endpoint": "7d0c2f1e-5b4a-4c3d-9e8f-0a1b2c3d4e5f"
      }
    }
  ],
  "steps": [
    {
      "id": "soan_lai",
      "type": "logic.loop@1",
      "description": "Soạn lại báo giá tới khi được duyệt",
      "config": {
        "condition": "vars.can_sua",
        "max_iterations": 3,
        "body": [
          {
            "id": "soan_bao_gia",
            "type": "ai.llm@2",
            "description": "Soạn báo giá",
            "config": {
              "instructions": "Chấm điểm lead theo tiêu chí của công ty.",
              "prompt": "Thông tin lead: {{ trigger.input }}",
              "output": "object",
              "output_schema": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "integer"
                  },
                  "tier": {
                    "type": "string"
                  }
                }
              }
            },
            "retry": {
              "max_attempts": 2,
              "backoff": "exponential"
            },
            "timeout_s": 120,
            "on_error": "fail"
          },
          {
            "id": "duyet_bao_gia",
            "type": "human.approval@2",
            "description": "Trưởng nhóm duyệt báo giá",
            "config": {
              "required_scope": "studio.leads.approve",
              "approved": [
                {
                  "id": "da_duyet",
                  "type": "data.transform@1",
                  "description": "Ghi nhận đã duyệt",
                  "config": {
                    "fields": {
                      "can_sua": "false"
                    }
                  },
                  "retry": {
                    "max_attempts": 1,
                    "backoff": "fixed"
                  },
                  "timeout_s": 30,
                  "on_error": "fail"
                }
              ],
              "rejected": [
                {
                  "id": "can_sua_lai",
                  "type": "data.transform@1",
                  "description": "Ghi nhận cần sửa",
                  "config": {
                    "fields": {
                      "can_sua": "true"
                    }
                  },
                  "retry": {
                    "max_attempts": 1,
                    "backoff": "fixed"
                  },
                  "timeout_s": 30,
                  "on_error": "fail"
                }
              ]
            },
            "retry": {
              "max_attempts": 1,
              "backoff": "fixed"
            },
            "timeout_s": 60,
            "on_error": "fail"
          }
        ],
        "max_reached": [
          {
            "id": "bao_quan_ly",
            "type": "data.object.create@1",
            "description": "Báo quản lý: quá ba lần sửa",
            "config": {
              "object": "task",
              "fields": {
                "title": "{{ trigger.input.full_name }}"
              }
            },
            "retry": {
              "max_attempts": 1,
              "backoff": "fixed"
            },
            "timeout_s": 30,
            "on_error": "fail"
          }
        ]
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 10,
      "on_error": "fail"
    },
    {
      "id": "duyet_hoi_dong",
      "type": "human.approval@2",
      "description": "Hội đồng duyệt báo giá lớn",
      "config": {
        "required_scope": "studio.leads.approve",
        "approval_rule": "all",
        "assignees": ["u_truong_phong", "u_ke_toan", "u_giam_doc"],
        "subject": "gui_bao_gia",
        "approved": [
          {
            "id": "gui_bao_gia",
            "type": "tool.call@2",
            "description": "Gửi báo giá cho khách",
            "config": {
              "tool": "email.send@1.0.0",
              "arguments": {
                "to": "{{ trigger.input.email }}"
              }
            },
            "retry": {
              "max_attempts": 3,
              "backoff": "exponential"
            },
            "timeout_s": 30,
            "on_error": "fail"
          }
        ],
        "rejected": [
          {
            "id": "dung_tu_choi",
            "type": "flow.stop@1",
            "description": "Dừng: hội đồng từ chối",
            "config": {},
            "retry": {
              "max_attempts": 1,
              "backoff": "fixed"
            },
            "timeout_s": 60,
            "on_error": "fail"
          }
        ]
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 60,
      "on_error": "fail"
    }
  ],
  "variables": [
    {
      "name": "can_sua",
      "type": "boolean",
      "default": true
    }
  ]
}
