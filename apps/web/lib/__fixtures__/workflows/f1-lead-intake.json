{
  "schema": "dw.workflow/v1",
  "triggers": [
    {
      "id": "nhan_lead",
      "type": "trigger.datahub@1",
      "description": "Khi Nguồn dữ liệu Form website nhận một lead",
      "config": {
        "endpoint": "7d0c2f1e-5b4a-4c3d-9e8f-0a1b2c3d4e5f"
      }
    }
  ],
  "steps": [
    {
      "id": "chuan_hoa",
      "type": "data.transform@1",
      "description": "Chuẩn hóa số điện thoại và email",
      "config": {
        "fields": {
          "phone": "phone.e164(trigger.input.phone)",
          "email": "email.normalize(trigger.input.email)"
        }
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 30,
      "on_error": "fail"
    },
    {
      "id": "luu_lead",
      "type": "data.object.upsert@1",
      "description": "Lưu hoặc cập nhật Lead",
      "config": {
        "object": "lead",
        "match_on": ["phone", "email"],
        "fields": {
          "phone": "{{ phone.e164(trigger.input.phone) }}",
          "email": "{{ email.normalize(trigger.input.email) }}",
          "full_name": "{{ trigger.input.full_name }}"
        }
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 30,
      "on_error": "fail"
    },
    {
      "id": "tim_viec_mo",
      "type": "data.object.query@1",
      "description": "Tìm việc đang mở của lead",
      "config": {
        "object": "lead",
        "filter": {
          "field": "status",
          "op": "eq",
          "value": "moi"
        },
        "limit": 50
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 30,
      "on_error": "fail"
    },
    {
      "id": "cham_diem",
      "type": "ai.llm@2",
      "description": "Chấm điểm lead bằng AI",
      "config": {
        "instructions": "Chấm điểm lead theo tiêu chí của công ty.",
        "prompt": "Thông tin lead: {{ trigger.input }}",
        "output": "object",
        "output_schema": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer"
            },
            "tier": {
              "type": "string"
            }
          }
        }
      },
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential"
      },
      "timeout_s": 120,
      "on_error": "fail"
    },
    {
      "id": "phan_loai",
      "type": "logic.switch@1",
      "description": "Phân loại theo hạng",
      "config": {
        "on": "steps.cham_diem.response.tier",
        "cases": {
          "hot": [
            {
              "id": "giao_sales",
              "type": "data.object.assign@1",
              "description": "Giao cho nhân viên kinh doanh",
              "config": {
                "object": "lead",
                "record_id": "{{ steps.luu_lead.record.id }}",
                "fallback": "sales_lead",
                "reassign": false
              },
              "retry": {
                "max_attempts": 1,
                "backoff": "fixed"
              },
              "timeout_s": 30,
              "on_error": "fail"
            },
            {
              "id": "duyet_uu_dai",
              "type": "human.approval@2",
              "description": "Duyệt ưu đãi cho lead nóng",
              "config": {
                "required_scope": "studio.leads.approve",
                "subject": "gui_uu_dai",
                "approved": [
                  {
                    "id": "gui_uu_dai",
                    "type": "tool.call@2",
                    "description": "Gửi email ưu đãi",
                    "config": {
                      "tool": "email.send@1.0.0",
                      "arguments": {
                        "to": "{{ trigger.input.email }}"
                      }
                    },
                    "retry": {
                      "max_attempts": 3,
                      "backoff": "exponential"
                    },
                    "timeout_s": 30,
                    "on_error": "fail"
                  },
                  {
                    "id": "danh_dau_uu_dai",
                    "type": "data.object.update@1",
                    "description": "Đánh dấu đã gửi ưu đãi",
                    "config": {
                      "object": "lead",
                      "record_id": "{{ steps.luu_lead.record.id }}",
                      "fields": {
                        "status": "da_lien_he"
                      }
                    },
                    "retry": {
                      "max_attempts": 1,
                      "backoff": "fixed"
                    },
                    "timeout_s": 30,
                    "on_error": "fail"
                  }
                ],
                "rejected": [
                  {
                    "id": "tao_viec_goi",
                    "type": "data.object.create@1",
                    "description": "Tạo việc gọi lại",
                    "config": {
                      "object": "task",
                      "fields": {
                        "title": "{{ trigger.input.full_name }}"
                      }
                    },
                    "retry": {
                      "max_attempts": 1,
                      "backoff": "fixed"
                    },
                    "timeout_s": 30,
                    "on_error": "fail"
                  }
                ]
              },
              "retry": {
                "max_attempts": 1,
                "backoff": "fixed"
              },
              "timeout_s": 60,
              "on_error": "fail"
            }
          ],
          "warm": [
            {
              "id": "gui_cham_soc",
              "type": "tool.call@2",
              "description": "Gửi email chăm sóc",
              "config": {
                "tool": "email.send@1.0.0",
                "arguments": {
                  "to": "{{ trigger.input.email }}"
                }
              },
              "retry": {
                "max_attempts": 3,
                "backoff": "exponential"
              },
              "timeout_s": 30,
              "on_error": "fail"
            },
            {
              "id": "tao_viec_theo_doi",
              "type": "data.object.create@1",
              "description": "Tạo việc theo dõi sau 3 ngày",
              "config": {
                "object": "task",
                "fields": {
                  "title": "{{ trigger.input.full_name }}"
                }
              },
              "retry": {
                "max_attempts": 1,
                "backoff": "fixed"
              },
              "timeout_s": 30,
              "on_error": "fail"
            }
          ]
        },
        "default": [
          {
            "id": "luu_tru",
            "type": "data.object.update@1",
            "description": "Đưa lead vào danh sách nuôi dưỡng",
            "config": {
              "object": "lead",
              "record_id": "{{ steps.luu_lead.record.id }}",
              "fields": {
                "status": "da_lien_he"
              }
            },
            "retry": {
              "max_attempts": 1,
              "backoff": "fixed"
            },
            "timeout_s": 30,
            "on_error": "fail"
          }
        ]
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 10,
      "on_error": "fail"
    },
    {
      "id": "bao_kenh",
      "type": "tool.call@2",
      "description": "Báo kênh bán hàng",
      "config": {
        "tool": "chat.post@1.0.0",
        "arguments": {
          "to": "{{ trigger.input.email }}"
        }
      },
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential"
      },
      "timeout_s": 30,
      "on_error": "fail"
    },
    {
      "id": "tong_ket",
      "type": "data.transform@1",
      "description": "Tổng kết lượt tiếp nhận",
      "config": {
        "fields": {
          "ket_qua": "steps.phan_loai.case"
        }
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 30,
      "on_error": "fail"
    }
  ]
}
