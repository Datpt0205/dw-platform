{
  "schema": "dw.workflow/v1",
  "triggers": [
    {
      "id": "nhan_lead",
      "type": "trigger.datahub@1",
      "description": "Khi Nguồn dữ liệu Form website nhận một lead",
      "config": {
        "endpoint": "7d0c2f1e-5b4a-4c3d-9e8f-0a1b2c3d4e5f"
      }
    }
  ],
  "steps": [
    {
      "id": "chuan_hoa",
      "type": "data.transform@1",
      "description": "Chuẩn hóa số điện thoại và email",
      "config": {
        "fields": {
          "ket_qua": "trigger.input"
        }
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 30,
      "on_error": "route",
      "error_lane": [
        {
          "id": "bao_loi_chuan_hoa",
          "type": "tool.call@2",
          "description": "Báo lỗi: không chuẩn hóa được",
          "config": {
            "tool": "chat.post@1.0.0",
            "arguments": {
              "to": "{{ trigger.input.email }}"
            }
          },
          "retry": {
            "max_attempts": 3,
            "backoff": "exponential"
          },
          "timeout_s": 30,
          "on_error": "fail"
        },
        {
          "id": "dung_chuan_hoa",
          "type": "flow.stop@1",
          "description": "Dừng vì không chuẩn hóa được",
          "config": {},
          "retry": {
            "max_attempts": 1,
            "backoff": "fixed"
          },
          "timeout_s": 60,
          "on_error": "fail"
        }
      ]
    },
    {
      "id": "luu_lead",
      "type": "data.object.upsert@1",
      "description": "Lưu hoặc cập nhật Lead",
      "config": {
        "object": "lead",
        "match_on": ["phone", "email"],
        "fields": {
          "phone": "{{ phone.e164(trigger.input.phone) }}",
          "email": "{{ email.normalize(trigger.input.email) }}",
          "full_name": "{{ trigger.input.full_name }}"
        }
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 30,
      "on_error": "route",
      "error_lane": [
        {
          "id": "bao_loi_luu_lead",
          "type": "tool.call@2",
          "description": "Báo lỗi: không lưu được lead",
          "config": {
            "tool": "chat.post@1.0.0",
            "arguments": {
              "to": "{{ trigger.input.email }}"
            }
          },
          "retry": {
            "max_attempts": 3,
            "backoff": "exponential"
          },
          "timeout_s": 30,
          "on_error": "fail"
        },
        {
          "id": "dung_luu_lead",
          "type": "flow.stop@1",
          "description": "Dừng vì không lưu được lead",
          "config": {},
          "retry": {
            "max_attempts": 1,
            "backoff": "fixed"
          },
          "timeout_s": 60,
          "on_error": "fail"
        }
      ]
    },
    {
      "id": "cham_diem",
      "type": "ai.llm@2",
      "description": "Chấm điểm lead bằng AI",
      "config": {
        "instructions": "Chấm điểm lead theo tiêu chí của công ty.",
        "prompt": "Thông tin lead: {{ trigger.input }}",
        "output": "object",
        "output_schema": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer"
            },
            "tier": {
              "type": "string"
            }
          }
        }
      },
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential"
      },
      "timeout_s": 120,
      "on_error": "route",
      "error_lane": [
        {
          "id": "diem_mac_dinh",
          "type": "data.transform@1",
          "description": "Đặt điểm mặc định",
          "config": {
            "fields": {
              "score": "0"
            }
          },
          "retry": {
            "max_attempts": 1,
            "backoff": "fixed"
          },
          "timeout_s": 30,
          "on_error": "fail"
        }
      ]
    },
    {
      "id": "giao_sales",
      "type": "data.object.assign@1",
      "description": "Giao cho nhân viên kinh doanh",
      "config": {
        "object": "lead",
        "record_id": "{{ steps.luu_lead.record.id }}",
        "fallback": "sales_lead",
        "reassign": false
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 30,
      "on_error": "route",
      "error_lane": [
        {
          "id": "bao_loi_giao_sales",
          "type": "tool.call@2",
          "description": "Báo lỗi: không giao được",
          "config": {
            "tool": "chat.post@1.0.0",
            "arguments": {
              "to": "{{ trigger.input.email }}"
            }
          },
          "retry": {
            "max_attempts": 3,
            "backoff": "exponential"
          },
          "timeout_s": 30,
          "on_error": "fail"
        }
      ]
    },
    {
      "id": "duyet_uu_dai",
      "type": "human.approval@2",
      "description": "Duyệt ưu đãi",
      "config": {
        "required_scope": "studio.leads.approve",
        "subject": "gui_uu_dai",
        "approved": [
          {
            "id": "gui_uu_dai",
            "type": "tool.call@2",
            "description": "Gửi email ưu đãi",
            "config": {
              "tool": "email.send@1.0.0",
              "arguments": {
                "to": "{{ trigger.input.email }}"
              }
            },
            "retry": {
              "max_attempts": 3,
              "backoff": "exponential"
            },
            "timeout_s": 30,
            "on_error": "route",
            "error_lane": [
              {
                "id": "bao_loi_gui_uu_dai",
                "type": "tool.call@2",
                "description": "Báo lỗi: gửi email lỗi",
                "config": {
                  "tool": "chat.post@1.0.0",
                  "arguments": {
                    "to": "{{ trigger.input.email }}"
                  }
                },
                "retry": {
                  "max_attempts": 3,
                  "backoff": "exponential"
                },
                "timeout_s": 30,
                "on_error": "fail"
              }
            ]
          }
        ],
        "rejected": [
          {
            "id": "tao_viec_goi",
            "type": "data.object.create@1",
            "description": "Tạo việc gọi lại",
            "config": {
              "object": "task",
              "fields": {
                "title": "{{ trigger.input.full_name }}"
              }
            },
            "retry": {
              "max_attempts": 1,
              "backoff": "fixed"
            },
            "timeout_s": 30,
            "on_error": "route",
            "error_lane": [
              {
                "id": "bao_loi_tao_viec_goi",
                "type": "tool.call@2",
                "description": "Báo lỗi: không tạo được việc",
                "config": {
                  "tool": "chat.post@1.0.0",
                  "arguments": {
                    "to": "{{ trigger.input.email }}"
                  }
                },
                "retry": {
                  "max_attempts": 3,
                  "backoff": "exponential"
                },
                "timeout_s": 30,
                "on_error": "fail"
              }
            ]
          }
        ]
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 60,
      "on_error": "route",
      "error_lane": [
        {
          "id": "bao_loi_duyet_uu_dai",
          "type": "tool.call@2",
          "description": "Báo lỗi: không có người duyệt",
          "config": {
            "tool": "chat.post@1.0.0",
            "arguments": {
              "to": "{{ trigger.input.email }}"
            }
          },
          "retry": {
            "max_attempts": 3,
            "backoff": "exponential"
          },
          "timeout_s": 30,
          "on_error": "fail"
        }
      ]
    },
    {
      "id": "cham_soc_dai_han",
      "type": "flow.subworkflow@1",
      "description": "Chạy quy trình chăm sóc dài hạn",
      "config": {
        "workflow": "cham_soc_lead",
        "inputs": {
          "lead_id": "steps.luu_lead.record.id"
        }
      },
      "retry": {
        "max_attempts": 1,
        "backoff": "fixed"
      },
      "timeout_s": 60,
      "on_error": "route",
      "error_lane": [
        {
          "id": "bao_loi_cham_soc_dai_han",
          "type": "tool.call@2",
          "description": "Báo lỗi: quy trình con lỗi",
          "config": {
            "tool": "chat.post@1.0.0",
            "arguments": {
              "to": "{{ trigger.input.email }}"
            }
          },
          "retry": {
            "max_attempts": 3,
            "backoff": "exponential"
          },
          "timeout_s": 30,
          "on_error": "fail"
        }
      ]
    },
    {
      "id": "bao_kenh",
      "type": "tool.call@2",
      "description": "Báo kênh bán hàng",
      "config": {
        "tool": "chat.post@1.0.0",
        "arguments": {
          "to": "{{ trigger.input.email }}"
        }
      },
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential"
      },
      "timeout_s": 30,
      "on_error": "route",
      "error_lane": [
        {
          "id": "bao_loi_bao_kenh",
          "type": "tool.call@2",
          "description": "Báo lỗi: không báo được kênh",
          "config": {
            "tool": "chat.post@1.0.0",
            "arguments": {
              "to": "{{ trigger.input.email }}"
            }
          },
          "retry": {
            "max_attempts": 3,
            "backoff": "exponential"
          },
          "timeout_s": 30,
          "on_error": "fail"
        }
      ]
    }
  ]
}
